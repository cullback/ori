exports [I16]

I16 := {}.(
    add : I16, I16 -> I16
    sub : I16, I16 -> I16
    mul : I16, I16 -> I16
    div : I16, I16 -> I16
    mod : I16, I16 -> I16
    equals : I16, I16 -> Bool
    compare : I16, I16 -> Order
    to_i64 : I16 -> I64
    to_bits : I16 -> U16

    min : I16, I16 -> I16
    min = |a, b| if a <= b then a else b

    max : I16, I16 -> I16
    max = |a, b| if a >= b then a else b

    to_str : I16 -> Str
    to_str = |n| I64.to_str(n.to_i64())

    hash : I16 -> U64
    hash = |n| U64.hash(n.to_bits().to_u64())
)
