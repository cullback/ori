exports [I32]

I32 := {}.(
    add : I32, I32 -> I32
    sub : I32, I32 -> I32
    mul : I32, I32 -> I32
    div : I32, I32 -> I32
    mod : I32, I32 -> I32
    equals : I32, I32 -> Bool
    compare : I32, I32 -> Order
    to_i64 : I32 -> I64
    to_u64 : I32 -> U64

    min : I32, I32 -> I32
    min = |a, b| if a <= b then a else b

    max : I32, I32 -> I32
    max = |a, b| if a >= b then a else b

    to_str : I32 -> Str
    to_str = |n| I64.to_str(n.to_i64())

    hash : I32 -> U64
    hash = |n| U64.hash(n.to_u64())
)
