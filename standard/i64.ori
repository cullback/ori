exports [I64]

I64 := {}.(
    add : I64, I64 -> I64
    sub : I64, I64 -> I64
    mul : I64, I64 -> I64
    div : I64, I64 -> I64
    mod : I64, I64 -> I64
    equals : I64, I64 -> Bool
    compare : I64, I64 -> Order
    to_u8 : I64 -> U8
    # Bit reinterpretation: same 64 bits, signed view -> unsigned view.
    # Negative values become large U64s.
    to_u64 : I64 -> U64

    min : I64, I64 -> I64
    min = |a, b| if a <= b then a else b

    max : I64, I64 -> I64
    max = |a, b| if a >= b then a else b

    # Decimal string representation. Negatives get a leading '-'.
    # ```ori
    # expect I64.to_str(0) == "0"
    # expect I64.to_str(42) == "42"
    # expect I64.to_str(-7) == "-7"
    # ```
    # Note: I64::MIN (-2^63) is mishandled because (0 - I64::MIN)
    # overflows. Correct handling needs unsigned arithmetic.
    to_str : I64 -> Str
    to_str = |n|
        if n == 0 then "0"
        else (
            negative = n < 0
            pos = if negative then 0 - n else n
            state = List.range(0, 20).walk_until({ digits: [], n: pos }, |s, _|
                if s.n == 0 then Break(s)
                else Continue({
                    digits: s.digits.append(I64.to_u8(s.n % 10 + 48)),
                    n: s.n / 10,
                })
            )
            with_sign = if negative then state.digits.append(45) else state.digits
            bytes = with_sign.reverse()
            if Str.from_utf8(bytes)
                : Ok(s) then s
                : Err(_) then ""
        )

    hash : I64 -> U64
    hash = |n| U64.hash(n.to_u64())
)
