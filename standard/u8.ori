exports [U8]

U8 := {}.(
    add : U8, U8 -> U8
    sub : U8, U8 -> U8
    mul : U8, U8 -> U8
    div : U8, U8 -> U8
    mod : U8, U8 -> U8
    bit_and : U8, U8 -> U8
    bit_or : U8, U8 -> U8
    bit_xor : U8, U8 -> U8
    shl : U8, U8 -> U8
    shr : U8, U8 -> U8
    equals : U8, U8 -> Bool
    compare : U8, U8 -> Order
    to_u64 : U8 -> U64

    min : U8, U8 -> U8
    min = |a, b| if a <= b then a else b

    max : U8, U8 -> U8
    max = |a, b| if a >= b then a else b

    to_str : U8 -> Str
    to_str = |n| U64.to_str(n.to_u64())

    hash : U8 -> U64
    hash = |n| U64.hash(n.to_u64())
)
